digraph batch {
	bgcolor="#F9FBFF" compound=true fontcolor="#132238" fontname="Noto Sans CJK SC" fontsize=26 fontweight=bold label="额外实例 · 三个请求 A/B/C：同一个 Scheduler 如何连续组批（示意，不是固定时刻表）" labelloc=t nodesep=0.36 outputorder=edgesfirst pad=0.32 rankdir=LR ranksep=0.53 splines=spline
	node [color="#64748B" fontcolor="#1E293B" fontname="Noto Sans CJK SC" fontsize=18 margin="0.18,0.13" penwidth=1.45 shape=box style="rounded,filled"]
